<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:liquid="clr-namespace:WalletWasabi.Fluent.ViewModels.Wallets.Liquid"
             xmlns:views="clr-namespace:WalletWasabi.Fluent.Views.Wallets.Liquid"
             xmlns:ui="clr-namespace:WalletWasabi.Liquid.Wallet.Ui;assembly=WalletWasabi"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:DataType="liquid:LiquidSendViewModel"
             x:CompileBindings="True"
             x:Class="WalletWasabi.Fluent.Views.Wallets.Liquid.LiquidSendView">
  <ContentArea Title="{Binding Title}"
               EnableCancel="{Binding EnableCancel}"
               EnableBack="{Binding EnableBack}"
               ScrollViewer.VerticalScrollBarVisibility="Auto">
    <StackPanel Spacing="12">

      <!-- The recipient row: confidential address, asset dropdown, raw
           atomic-units amount — one implementation hosted from
           LiquidSendRecipientView. -->
      <TextBlock Text="Confidential destination" Classes="h5" />
      <views:LiquidSendRecipientView DataContext="{Binding Recipient}" />

      <!-- The caller-supplied selected outpoints and the explicit fee. -->
      <TextBlock Text="Selected outpoints (one 72-char hex per line)" Classes="h5" />
      <TextBox Classes="monoSpaced"
               AcceptsReturn="True"
               MinHeight="80"
               Text="{Binding SelectedOutPointHexesText}" />
      <TextBox Watermark="Explicit fee (atomic units, pegged asset)"
               Text="{Binding ExplicitFeeAtomicUnits}" />

      <Button Content="Build plan"
              Classes="activeHyperlink"
              Command="{Binding BuildPlanCommand}" />

      <!-- Sign & broadcast: executes one ordinary send through the session
           layer's narrow send-execution delegate and renders the returned
           result (status + transaction ids). Visible only when the session
           wired an executor; fail-closed, no fabricated success. -->
      <Button Content="Sign &amp; broadcast"
              Classes="activeHyperlink"
              Command="{Binding ExecuteSendPlanCommand}"
              IsVisible="{Binding IsSendExecutionAvailable}" />

      <!-- The landed execution result, verbatim: status, display message,
           and the local/accepted transaction ids when present. -->
      <StackPanel IsVisible="{Binding ExecutionResult, Converter={x:Static ObjectConverters.IsNotNull}}" Spacing="4">
        <TextBlock Text="Send result" Classes="h5" />
        <TextBlock Classes="monoSpaced" Text="{Binding ExecutionResult.Status, StringFormat='Status: {0}'}" />
        <TextBlock TextWrapping="Wrap" Text="{Binding ExecutionResult.DisplayMessage}" />
        <TextBlock Classes="monoSpaced" TextWrapping="Wrap"
                   Text="{Binding ExecutionResult.LocalTransactionIdHex, StringFormat='Local txid: {0}'}"
                   IsVisible="{Binding ExecutionResult.LocalTransactionIdHex, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        <TextBlock Classes="monoSpaced" TextWrapping="Wrap"
                   Text="{Binding ExecutionResult.AcceptedTransactionIdHex, StringFormat='Accepted txid: {0}'}"
                   IsVisible="{Binding ExecutionResult.AcceptedTransactionIdHex, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
      </StackPanel>

      <!-- A landed rejection surfaces as-is; no success is fabricated. -->
      <TextBlock TextWrapping="Wrap"
                 Text="{Binding ExecutionErrorText}"
                 IsVisible="{Binding ExecutionErrorText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

      <!-- The exact spend plan is the send flow's primary content. Amounts
           render the pegged-aware display form: the L-BTC decimal for the
           pegged asset (the explicit fee is always pegged-denominated), the
           raw atomic-unit count for any issued asset (unknown precision —
           never scaled). -->
      <StackPanel IsVisible="{Binding SpendPlan, Converter={x:Static ObjectConverters.IsNotNull}}" Spacing="8">
        <TextBlock Text="Exact spend plan" Classes="h5" />
        <TextBlock Classes="monoSpaced" Text="{Binding SpendPlan.SelectedInputCount, StringFormat='Selected inputs: {0}'}" />
        <TextBlock Classes="monoSpaced" Text="{Binding SpendPlan.ConfidentialOutputCount, StringFormat='Confidential outputs: {0}'}" />
        <TextBlock Classes="monoSpaced" Text="{Binding SpendPlan.SourceRevision, StringFormat='Source revision: {0}'}" />
        <TextBlock Classes="monoSpaced" Text="{Binding SpendPlan.ExplicitFee.AmountDisplayText, StringFormat='Explicit fee: {0}'}" />
        <ItemsControl ItemsSource="{Binding SpendPlan.Destinations}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="liquid:LiquidSpendPlanDestinationItemViewModel">
              <StackPanel Spacing="2">
                <TextBlock Classes="monoSpaced" TextWrapping="Wrap" Text="{Binding ConfidentialAddressText}" />
                <TextBlock Classes="monoSpaced" Text="{Binding AssetIdHex}" />
                <TextBlock Classes="monoSpaced" Text="{Binding AmountDisplayText}" />
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <ItemsControl ItemsSource="{Binding SpendPlan.SelectedTotals}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="liquid:LiquidSpendPlanAssetAmountItemViewModel">
              <TextBlock Classes="monoSpaced" Text="{Binding AmountDisplayText}" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </StackPanel>
  </ContentArea>
</UserControl>
