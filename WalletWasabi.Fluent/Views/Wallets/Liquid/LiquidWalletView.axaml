<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:liquid="clr-namespace:WalletWasabi.Fluent.ViewModels.Wallets.Liquid"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:DataType="liquid:LiquidWalletViewModel"
             x:CompileBindings="True"
             x:Class="WalletWasabi.Fluent.Views.Wallets.Liquid.LiquidWalletView">
  <ContentArea Title="{Binding Title}"
               EnableCancel="{Binding EnableCancel}"
               EnableBack="{Binding EnableBack}">
    <DockPanel LastChildFill="True">

      <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                  HorizontalAlignment="Center" Spacing="16">
        <Button Focusable="False" Content="Send"
                Classes="h8 plain activeHyperLink" Command="{Binding SendCommand}" Cursor="Hand" />
        <Button Focusable="False" Content="Receive"
                Classes="h8 plain activeHyperLink" Command="{Binding ReceiveCommand}" Cursor="Hand" />
      </StackPanel>

      <ScrollViewer DockPanel.Dock="Top" VerticalScrollBarVisibility="Auto">
        <StackPanel>

          <!-- The multiasset balance set is the primary content: one row per
               asset, pegged asset (L-BTC) first, then issued assets in the
               landed canonical ascending asset-id-hex order. Each row renders
               the asset id's canonical hex and the exact atomic-unit amount;
               every value is confidential on chain. -->
          <ItemsControl ItemsSource="{Binding BalanceRows}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="liquid:LiquidAssetBalanceItemViewModel">
                <DockPanel Margin="0 4 0 4">
                  <TextBlock DockPanel.Dock="Left" Classes="monoSpaced"
                             Text="{Binding AssetIdHex}" />
                  <TextBlock DockPanel.Dock="Right" Classes="monoSpaced"
                             Text="{Binding AtomicUnits}" />
                  <TextBlock DockPanel.Dock="Right" Margin="8 0 8 0"
                             Text="L-BTC" IsVisible="{Binding IsPeggedAsset}" />
                  <TextBlock DockPanel.Dock="Right" Margin="8 0 0 0"
                             Text="confidential" IsVisible="{Binding IsConfidential}" />
                </DockPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <!-- Liquid transaction history: newest applied first, a complete
               revision-scoped replacement. The list is virtualizing and
               keyboard-navigable with one tab stop and Up/Down row traversal.
               The full transaction id and the per-asset formatted amounts are
               shown in full and wrapped in PrivacyContentControl (text
               replacement); the toggle masks, it never removes. Status and
               credit/debit are always text, never color/icon alone. No block
               hash, address, label, outpoint, fee, or timestamp appears
               anywhere (the retained history does not carry them). -->
          <TextBlock Classes="h8" Margin="0 16 0 4" Text="History" />

          <!-- Unloaded / updating state: no prior rows are exposed. -->
          <TextBlock Margin="0 4 0 4"
                     Text="Liquid transaction history is not available at this wallet revision"
                     IsVisible="{Binding !IsHistoryLoaded}" />

          <!-- Empty state: history is loaded but the retained wallet history
               has no transactions. -->
          <TextBlock Margin="0 4 0 4"
                     Text="No Liquid transactions in the retained wallet history"
                     IsVisible="{Binding IsHistoryEmpty}" />

          <ListBox ItemsSource="{Binding HistoryRows}"
                   AutomationProperties.Name="Liquid transaction history"
                   IsVisible="{Binding IsHistoryLoaded}"
                   SelectedIndex="{Binding SelectedHistoryIndex, Mode=TwoWay}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="liquid:LiquidHistoryItemViewModel">
                <StackPanel Margin="0 6 0 6"
                            AutomationProperties.Name="{Binding AccessibilitySummary}">
                  <DockPanel>
                    <TextBlock DockPanel.Dock="Left" Text="{Binding StatusText}" />
                    <!-- Display-only full canonical transaction id; never a key/identity. -->
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="4">
                      <PrivacyContentControl PrivacyReplacementMode="Text"
                                             UseOpacity="False">
                        <TextBlock Classes="monoSpaced" Opacity="0.7"
                                   TextWrapping="Wrap"
                                   Text="{Binding TransactionId}" />
                      </PrivacyContentControl>
                      <AnimatedButton ToolTip.Tip="Copy transaction id"
                                      Command="{Binding CopyTransactionIdCommand}"
                                      NormalIcon="{StaticResource copy_regular}"
                                      ClickIcon="{StaticResource copy_confirmed}" />
                    </StackPanel>
                  </DockPanel>

                  <ItemsControl ItemsSource="{Binding AssetChanges}"
                                IsVisible="{Binding HasBalanceChange}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="liquid:LiquidHistoryAssetChangeItemViewModel">
                        <DockPanel Margin="16 2 0 2">
                          <TextBlock DockPanel.Dock="Left" Text="{Binding DirectionText}" />
                          <PrivacyContentControl DockPanel.Dock="Right"
                                                 PrivacyReplacementMode="Text"
                                                 UseOpacity="False">
                            <TextBlock Classes="monoSpaced"
                                       TextWrapping="Wrap"
                                       Text="{Binding DisplayAmount}" />
                          </PrivacyContentControl>
                        </DockPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>

                  <TextBlock Margin="16 2 0 2" Opacity="0.7"
                             Text="{Binding EmptyChangeText}"
                             IsVisible="{Binding !HasBalanceChange}" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

        </StackPanel>
      </ScrollViewer>

    </DockPanel>
  </ContentArea>
</UserControl>
