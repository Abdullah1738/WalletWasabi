<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<DisableImplicitNamespaceImports>true</DisableImplicitNamespaceImports>
		<TargetLatestRuntimePatch>true</TargetLatestRuntimePatch>
		<NoWarn>1701;1702;1705;1591;1573;CA1031;CA1822</NoWarn>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
		<DisableImplicitNuGetFallbackFolder>true</DisableImplicitNuGetFallbackFolder>
		<PathMap>$(MSBuildProjectDirectory)\=WalletWasabi</PathMap>
	</PropertyGroup>

	<PropertyGroup>
		<PackageId>WalletWasabi</PackageId>
	</PropertyGroup>

	<Target Name="WriteMetadata" BeforeTargets="PrepareForBuild">
		<ItemGroup>
			<AssemblyMetadata Include="CommitHash" Value="$(CommitHash)" />
		</ItemGroup>
	</Target>

	<ItemGroup>
		<!-- TODO: Workaround for incompatible package Microsoft.AspNetCore.Mvc.NewtonsoftJson -->
		<PackageReference Include="Microsoft.AspNetCore.WebUtilities" />
		<PackageReference Include="Microsoft.Extensions.Caching.Abstractions" />
		<PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
		<PackageReference Include="Microsoft.Extensions.Http" />
		<PackageReference Include="NNostr.Client" />
		<PackageReference Include="Microsoft.Data.Sqlite" />
		<PackageReference Include="Microsoft.Win32.SystemEvents" />
		<PackageReference Include="NBitcoin" />
		<PackageReference Include="System.Linq.Async" />
		<PackageReference Include="WabiSabi" />
	</ItemGroup>

	<ItemGroup>
		<!-- Tor. -->
		<None Update="BundledApps\Binaries\linux-arm64\Tor\**\*">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
		<None Update="BundledApps\Binaries\linux-x64\Tor\**\*">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
		<None Update="BundledApps\Binaries\osx64\Tor\**\*">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
		<None Update="BundledApps\Binaries\win-x64\Tor\**\*">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
		<!-- HWI. -->
		<None Update="BundledApps\Binaries\linux-arm64\hwi">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
		<None Update="BundledApps\Binaries\linux-x64\hwi">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
		<None Update="BundledApps\Binaries\osx64\hwi">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
		<None Update="BundledApps\Binaries\win-x64\hwi.exe">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
		<!-- GEOIP. -->
		<None Update="Tor\Geoip\geoip">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
		<None Update="Tor\Geoip\geoip6">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
		<!-- Rest. -->
		<None Update="Announcements\ReleaseHighlights.md">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
		<!-- MANAGED-WALLET-SIGN-FFI-001: the pinned-commit production native signing cdylib,
		     copied into the NativeSigning/ subdirectory next to the assembly so the binding's
		     explicit NativeLibrary.Load path resolves it without colliding with the test-only
		     validation cdylib the test assembly links flat under the same file name. The bytes
		     are SHA-256-pinned per platform in
		     Liquid/Wallet/Ui/LiquidWalletNativeSigningBinding.cs. -->
		<None Update="Liquid\Wallet\Ui\Native\libwasabi_liquid_wlpq_v1.dylib">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<Link>NativeSigning\libwasabi_liquid_wlpq_v1.dylib</Link>
			<Visible>false</Visible>
		</None>
		<None Update="Liquid\Wallet\Ui\Native\libwasabi_liquid_wlpq_v1.so">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<Link>NativeSigning\libwasabi_liquid_wlpq_v1.so</Link>
			<Visible>false</Visible>
		</None>
		<!-- MANAGED-WALLET-FACTS-FFI-001: the pinned-commit production native wallet-facts
		     cdylib, copied into the NativeWalletFacts/ subdirectory next to the assembly so the
		     binding's explicit NativeLibrary.Load path resolves it without colliding with the
		     NativeSigning/ cdylib family or any test-flat cdylib. The bytes are SHA-256-pinned
		     per platform in Liquid/Wallet/Ui/LiquidWalletNativeFactsBinding.cs. -->
		<None Update="Liquid\Wallet\Ui\Native\libwasabi_liquid_wallet_facts_v1.dylib">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<Link>NativeWalletFacts\libwasabi_liquid_wallet_facts_v1.dylib</Link>
			<Visible>false</Visible>
		</None>
		<None Update="Scheme\Wasabilib.scm">
		  <CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</None>
		<None Update="Scheme\Stdlib.scm">
		  <CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</None>
	</ItemGroup>

	<ItemGroup>
		<RuntimeHostConfigurationOption Include="System.Globalization.Invariant" Value="true" />
	</ItemGroup>
</Project>
